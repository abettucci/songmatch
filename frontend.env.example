# Frontend Environment Variables

# API URL - Change this to your API Gateway endpoint in production.
# Configure the same variable in Vercel → Project → Settings → Environment Variables.
# Local development
VITE_API_URL=http://localhost:8080

# Production (update after deploying backend)
# VITE_API_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com
# Public regional S3 hostname for the private, signed stem audio URLs (Terraform output).
VITE_STEM_ARTIFACTS_HOST=songmatch-stems-ACCOUNT_ID-us-east-1.s3.us-east-1.amazonaws.com

# AWS Configuration
aws_region  = "us-east-1"
environment = "prod"

# Spotify API Credentials
# Get these from: https://developer.spotify.com/dashboard
spotify_client_id     = "your_spotify_client_id_here"
spotify_client_secret = "your_spotify_client_secret_here"

# Last.fm API Key
# Get this from: https://www.last.fm/api/account/create
lastfm_api_key = "your_lastfm_api_key_here"

# Database Configuration (AWS RDS)
# RDS will be created automatically by Terraform
# Set a strong password (min 8 characters)
db_username = "soundmatch_admin"
db_password = "YourStrongPassword123!"  # CHANGE THIS!
db_name     = "soundmatch"


# AWS only runs the FastAPI Lambda and API Gateway. PostgreSQL lives in Supabase.
aws_region  = "us-east-1"
environment = "prod"

spotify_client_id     = "your_spotify_client_id"
spotify_client_secret = "your_spotify_client_secret"
spotify_redirect_uri  = "https://your-api-id.execute-api.us-east-1.amazonaws.com/api/v1/auth/spotify/callback"
lastfm_api_key        = "your_lastfm_api_key"

# Supabase Dashboard → Connect → Transaction pooler. Keep sslmode=require.
# Do not commit your real URL.
database_url  = "postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require"
jwt_secret_key = "replace-with-a-long-random-secret"

frontend_url = "https://your-project.vercel.app"
# Add the production domain and any preview domain only when needed.
cors_origins = "https://your-project.vercel.app"
